{
  "name": "My Library",
  "short_name": "My Library",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "lang": "en",
  "dir": "ltr",
  "background_color": "#6e1728",
  "theme_color": "#990000",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "./?share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "files",
          "accept": [
            "text/html",
            ".html",
            ".htm",
            "application/epub+zip",
            ".epub"
          ]
        }
      ]
    }
  }
}